# Nome do dataset
DATASET=captar-libras_2026

# Diretório para a raiz do novo dataset
DATASET_ROOT=../datasets_srv/captar-libras_2026

# Caminhos dos arquivos CSV gerados no split (date,sentence_id,person_id,video_id,video_path)
TEST_CSV_PATH=../datasets_/2026/test.csv
VALIDATE_CSV_PATH=../datasets_/2026/validate.csv
TRAIN_CSV_PATH=../datasets_/2026/train.csv

# Caminho do arquivo de anotações do ELAN (VideoID,Datetime,Sentence,Gloss,time_1,time_2)
ANNOTATIONS_PATH=../datasets_/2026/consistency_check-2026/consistencia_file.csv
SIGNALS_ANNOTATIONS_PATH=../datasets_/2026/consistency_check-2026/signals_file.csv


# Número de workers para processamento paralelo
NUM_WORKERS=16

# Diretório para salvar anotações processadas
ANNOTATION_ROOT=../datasets_srv/captar-libras_2026/annotations/

# Prefixo para o arquivo de anotações [MANTENHA {}.csv para substituição automática]
ANNOTATION_PREFIX=annotations/{}.csv

# Resolução de saída dos vídeos
OUTPUT_RES=(256, 256)

# Caminho para salvar os frames processados [MANTENHA '(dsize)' para substituição automática]
FRAME_FOLDER=../datasets_srv/captar-libras_2026/features/fullFrame-(dsize)px

# Habilita a equalização de histograma para clareamente das imagens
EQUALIZE = 1

# Define o método de CROP (0: Crop central, 1: YOLO Crop Estatico, 2; YOLO Crop Dinamico, 3: YOLO Crop Estatico e Dinamico)
CROP_MODE = 1